# Cloudinary (required for live mode). From the console dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Set to 1 once the Amazon Rekognition AI Moderation add-on is enabled in the Cloudinary console
CLOUDINARY_MODERATION=0
# Google AI Studio key, used for Gemma 4 (free tier)
GEMINI_API_KEY=
# Optional fallback provider
ANTHROPIC_API_KEY=
# gemma | claude | demo
LLM_PROVIDER=gemma
# Any long random string
SESSION_SECRET=
# 1 forces demo mode (seeded profile, uploads disabled)
DEMO_MODE=0
